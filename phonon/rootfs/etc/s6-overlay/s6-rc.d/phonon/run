#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the Phonon server, answering the Wyoming protocol on port 10200.
# ==============================================================================

language="$(bashio::config 'language')"

# Downloads go to /data, so they survive restarts and updates.
export HF_HOME=/data/huggingface
if bashio::config.has_value 'hf_token'; then
    HF_TOKEN="$(bashio::config 'hf_token')"
    export HF_TOKEN
fi

# No model: English gets the server's default, Phonon 31m. Every other language gets its
# Phonon 40m model, which is gated, so it needs a token.
model=""
if bashio::config.has_value 'model'; then
    model="$(bashio::config 'model')"
fi
if [[ -z "${model}" && "${language}" != 'en' ]]; then
    model="hf://gradium/phonon-40m-${language}"
    if [[ -z "${HF_TOKEN:-}" ]]; then
        bashio::exit.nok "For ${language}, Phonon uses ${model#hf://}, which is gated. Accept its terms at https://huggingface.co/${model#hf://} and set the 'hf_token' option, or set 'model' to another checkpoint."
    fi
fi
# A bare owner/name is a Hugging Face repo here.
if [[ -n "${model}" && "${model}" != /* && "${model}" != hf://* ]]; then
    model="hf://${model}"
fi

threads="$(bashio::config 'threads')"
if [[ "${threads}" -gt 0 ]]; then
    export RAYON_NUM_THREADS="${threads}"
fi

if bashio::config.true 'debug_logging'; then
    export RUST_LOG=debug
fi

args=(
    --lang "${language}"
    # The HTTP API is for other clients; inside the app, nothing else needs it.
    --addr 127.0.0.1:8880
    --wyoming-addr 0.0.0.0:10200
)

quant="$(bashio::config 'quant')"
if [[ "${quant}" != 'f32' ]]; then
    args+=(--quant "${quant}")
fi

if [[ -n "${model}" ]]; then
    args+=(--model "${model}")
fi

bashio::log.info "Starting Phonon with ${model:-the default model}. The first start downloads it and the voices, which can take a while."
exec ptts-openai-server "${args[@]}"
